# OmniLite Standalone configuration
# Location: <datadir>/omnilite-standalone.conf
#   Windows: %APPDATA%\OmniLiteStandalone\omnilite-standalone.conf
#   Linux:   ~/.omnilite-standalone/omnilite-standalone.conf
# Every key can also be given as a flag, e.g. -network=regtest.

# main, test or regtest
network=main

# litecoind RPC. Needs -txindex=1 and an unpruned chain.
rpcconnect=127.0.0.1
#rpcport=9332
#rpcuser=
#rpcpassword=
# Used when rpcpassword is empty. Default: the .cookie in the Litecoin data directory.
#rpccookiefile=

# Seconds between checks for new blocks once synced.
#pollinterval=5

# Blocks of undo data kept for reorgs (minimum 10).
#undodepth=100

# Regtest only: extra senders allowed to send feature activations and alerts
# (like OmniLite's -omniactivationallowsender / -omnialertallowsender), comma-separated.
# This changes the computed state, so never set it on mainnet.
#omniactivationallowsender=any
#omnialertallowsender=any

# Log the consensus hash every n blocks (0: off). Compare with OmniLite's
# omni_getcurrentconsensushash or -omnishowblockconsensushash.
#consensushash=10000

# JSON-RPC API with the omni_* calls of omnilitecored (api=0 turns it off).
# Without apipassword a random one is written to <datadir>/<network>/.cookie
# as "__cookie__:<password>". Default port: rpcport + 100 (9432 on mainnet).
#api=1
#apibind=127.0.0.1
#apiport=9432
#apiuser=omni
#apipassword=change-me
